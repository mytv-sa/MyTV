<?xml version="1.0" encoding="utf-8"?>
<!-- a settings row: dark green glass (a translucent gradient with a thin light edge and a brighter line along the top; no blur, weak TVs),
     gold-tinted with a gold edge while it has the focus. The same look as the «تلاوة وأذان» rows in the launcher. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#4D9C9A5E" android:endColor="#33467A52" />
                    <stroke android:width="2dp" android:color="#FFD6AF6B" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="2dp" android:height="1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#59FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2E3F7A5C" android:endColor="#1A123A28" />
                    <stroke android:width="1dp" android:color="#1FFFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:height="1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
